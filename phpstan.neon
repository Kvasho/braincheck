includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Stage 0 target: level 7, no baseline. Fix issues instead of ignoring them.
    level: 7

    tmpDir: storage/framework/cache/phpstan
